# Fleet edge router — *.agents.turingplanet.ai lands here (Railway terminates TLS).
# Routes by hostname to member services over Railway private networking.
# This file IS the routing table: the M5 deploy workflow regenerates it from
# deployments.yaml and redeploys this service.
:{$PORT} {
	@hello_fleet host hello-fleet.agents.turingplanet.ai
	handle @hello_fleet {
		reverse_proxy http://hello-fleet.railway.internal:8080
	}

	handle {
		respond "unknown agent — see https://agents.turingplanet.ai" 404
	}
}
